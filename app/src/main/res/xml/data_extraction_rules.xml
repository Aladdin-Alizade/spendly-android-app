<?xml version="1.0" encoding="utf-8"?>
<!--
  What Android may take, on API 31 and above. See backup_rules.xml for why the
  session is left out of both cloud backup and device-to-device transfer: a
  refresh token that exists on two devices is a session those devices end for
  each other.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="spendly.supabase.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="spendly.supabase.xml" />
    </device-transfer>
</data-extraction-rules>
